generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Environment {
  PRODUCTION
  STAGING
  LAB
  DEV
}

enum RoleName {
  SUPER_ADMIN
  NETWORK_ADMIN
  NETWORK_OPERATOR
  AUDITOR
  VIEWER
}

enum DeviceRole {
  ROUTER
  SWITCH
  FIREWALL
  SERVER
  ACCESS_POINT
  CLIENT
}

enum DeviceStatus {
  PLANNED
  ACTIVE
  MAINTENANCE
  OFFLINE
  DECOMMISSIONED
}

enum InterfaceStatus {
  UP
  DOWN
  ADMIN_DOWN
}

enum Duplex {
  AUTO
  FULL
  HALF
}

enum VlanRole {
  DATA
  VOICE
  MANAGEMENT
  GUEST
  SERVER
  TRANSIT
  NATIVE
}

enum SecurityZone {
  TRUST
  UNTRUST
  DMZ
  GUEST
  MANAGEMENT
  INTERNAL
}

enum VlanStatus {
  ACTIVE
  PLANNED
  RESERVED
  DEPRECATED
}

enum PortMode {
  ACCESS
  TRUNK
}

enum PortStatus {
  UP
  DOWN
  ADMIN_DOWN
  ERR_DISABLED
}

enum PoeStatus {
  OFF
  ON
  FAULT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships        Membership[]
  auditEvents        AuditEvent[]
  dnsChanges         DnsChange[]
  changeLogs         ChangeLog[]
  diagnosticSessions DiagnosticSession[]
  labPromotions      LabPromotion[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sites       Site[]
  memberships Membership[]
  devices     Device[]
  ipNetworks  IpNetwork[]
  ipAddresses IpAddress[]
  dhcpServers DhcpServer[]
  dnsServers  DnsServer[]
  dnsZones    DnsZone[]
  firewallZones FirewallZone[]
  flowRules   FlowRule[]
  acls        Acl[]
  topologyPlacements TopologyPlacement[]
  topologyMarkers    TopologyMarker[]
  topologyLinks      TopologyLink[]
  topologyDiscoveries TopologyDiscovery[]
  monitoringTargets    MonitoringTarget[]
  discoveryRuns        DiscoveryRun[]
  automationPolicy     AutomationPolicy?
  automationTemplates  AutomationTemplate[]
  automationJobs       AutomationJob[]
  changeRequests       ChangeRequest[]
  configVersions       ConfigVersion[]
  changeLogs           ChangeLog[]
  diagnosticSessions   DiagnosticSession[]
  labFabrics           LabFabric[]
  labPromotions        LabPromotion[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           RoleName
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Site {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  code           String
  environment    Environment @default(PRODUCTION)
  address        String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  buildings    Building[]
  devices      Device[]
  vlans        Vlan[]
  ipNetworks   IpNetwork[]
  dhcpServers  DhcpServer[]
  dnsServers   DnsServer[]
  topologyMarkers TopologyMarker[]
  discoveryRuns   DiscoveryRun[]
  labFabrics      LabFabric[]
  labPromotions   LabPromotion[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sites")
}

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  rooms   Room[]
  devices Device[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("buildings")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  name       String
  code       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  racks    Rack[]
  devices  Device[]

  @@unique([buildingId, code])
  @@index([buildingId])
  @@map("rooms")
}

model Rack {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String
  code      String
  heightU   Int      @default(42) @map("height_u")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room    Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  devices Device[]

  @@unique([roomId, code])
  @@index([roomId])
  @@map("racks")
}

model Device {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  siteId         String       @map("site_id") @db.Uuid
  buildingId     String?      @map("building_id") @db.Uuid
  roomId         String?      @map("room_id") @db.Uuid
  rackId         String?      @map("rack_id") @db.Uuid
  role           DeviceRole
  hostname       String
  managementIp   String?      @map("management_ip")
  vendor         String?
  model          String?
  os             String?
  osVersion      String?      @map("os_version")
  serialNumber   String?      @map("serial_number")
  status         DeviceStatus @default(PLANNED)
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  building     Building?          @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  room         Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  rack              Rack?              @relation(fields: [rackId], references: [id], onDelete: Restrict)
  interfaces        NetworkInterface[]
  switchPorts       SwitchPort[]       @relation("SwitchPorts")
  connectedPorts    SwitchPort[]       @relation("ConnectedDevice")
  dhcpServers       DhcpServer[]
  dnsServers        DnsServer[]
  layer3Interfaces  Layer3Interface[]
  routes            Route[]
  ospfProcess       OspfProcess?
  acls              Acl[]
  topologyPlacement TopologyPlacement?
  topologySourceLinks TopologyLink[] @relation("TopologySourceDevice")
  topologyTargetLinks TopologyLink[] @relation("TopologyTargetDevice")
  monitoringTarget     MonitoringTarget?
  discoveryMatches     DiscoveryFinding[] @relation("DiscoveryMatch")
  discoveryImports     DiscoveryFinding[] @relation("DiscoveryImport")
  automationJobs       AutomationJob[]
  changeRequests       ChangeRequest[]
  configVersions       ConfigVersion[]
  changeLogs           ChangeLog[]
  diagnosticSessions   DiagnosticSession[]

  @@unique([organizationId, hostname])
  @@unique([organizationId, managementIp])
  @@unique([organizationId, serialNumber])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([siteId])
  @@index([rackId])
  @@map("devices")
}

model NetworkInterface {
  id          String           @id @default(uuid()) @db.Uuid
  deviceId    String           @map("device_id") @db.Uuid
  name        String
  ipAddress   String?          @map("ip_address")
  macAddress  String?          @map("mac_address")
  speedMbps   Int?             @map("speed_mbps")
  duplex      Duplex?
  status      InterfaceStatus  @default(DOWN)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  ipAllocation IpAddress?
  dhcpRelays   DhcpRelay[]
  layer3Children Layer3Interface[]

  @@unique([deviceId, name])
  @@index([deviceId])
  @@index([macAddress])
  @@map("network_interfaces")
}

model Vlan {
  id           String       @id @default(uuid()) @db.Uuid
  siteId       String       @map("site_id") @db.Uuid
  vid          Int
  name         String
  description  String?
  role         VlanRole
  securityZone SecurityZone @map("security_zone")
  status       VlanStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  site         Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  accessPorts  SwitchPort[]     @relation("AccessVlan")
  nativePorts  SwitchPort[]     @relation("NativeVlan")
  trunkPorts   SwitchPortVlan[]
  subnets      IpSubnet[]
  layer3Interfaces Layer3Interface[]
  zoneMembership   FirewallZoneVlan?
  topologyLinks    TopologyLink[]

  @@unique([siteId, vid])
  @@unique([siteId, name])
  @@index([siteId, status])
  @@map("vlans")
}

model SwitchPort {
  id                 String     @id @default(uuid()) @db.Uuid
  deviceId           String     @map("device_id") @db.Uuid
  name               String
  status             PortStatus @default(DOWN)
  mode               PortMode
  accessVlanId       String?    @map("access_vlan_id") @db.Uuid
  nativeVlanId       String?    @map("native_vlan_id") @db.Uuid
  speedMbps          Int?       @map("speed_mbps")
  duplex             Duplex?
  description        String?
  connectedDeviceId  String?    @map("connected_device_id") @db.Uuid
  macAddress         String?    @map("mac_address")
  poe                PoeStatus  @default(OFF)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  device          Device           @relation("SwitchPorts", fields: [deviceId], references: [id], onDelete: Restrict)
  accessVlan      Vlan?            @relation("AccessVlan", fields: [accessVlanId], references: [id], onDelete: Restrict)
  nativeVlan      Vlan?            @relation("NativeVlan", fields: [nativeVlanId], references: [id], onDelete: Restrict)
  connectedDevice Device?          @relation("ConnectedDevice", fields: [connectedDeviceId], references: [id], onDelete: Restrict)
  allowedVlans    SwitchPortVlan[]

  @@unique([deviceId, name])
  @@index([deviceId])
  @@index([accessVlanId])
  @@index([nativeVlanId])
  @@index([macAddress])
  @@map("switch_ports")
}

model SwitchPortVlan {
  portId String @map("port_id") @db.Uuid
  vlanId String @map("vlan_id") @db.Uuid

  port SwitchPort @relation(fields: [portId], references: [id], onDelete: Cascade)
  vlan Vlan       @relation(fields: [vlanId], references: [id], onDelete: Restrict)

  @@id([portId, vlanId])
  @@index([vlanId])
  @@map("switch_port_vlans")
}

enum IpFamily {
  IPV4
  IPV6
}

enum IpAddressRole {
  GATEWAY
  ALLOCATED
  RESERVED
}

model IpNetwork {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  name           String
  description    String?
  cidr           String
  family         IpFamily
  prefixLength   Int      @map("prefix_length")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  subnets      IpSubnet[]

  @@unique([siteId, cidr])
  @@unique([siteId, name])
  @@index([organizationId, family])
  @@map("ip_networks")
}

model IpSubnet {
  id               String   @id @default(uuid()) @db.Uuid
  networkId        String   @map("network_id") @db.Uuid
  vlanId           String   @map("vlan_id") @db.Uuid
  name             String
  description      String?
  cidr             String
  family           IpFamily
  prefixLength     Int      @map("prefix_length")
  gatewayAddressId String?  @unique @map("gateway_address_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  network        IpNetwork  @relation(fields: [networkId], references: [id], onDelete: Restrict)
  vlan           Vlan       @relation(fields: [vlanId], references: [id], onDelete: Restrict)
  gatewayAddress IpAddress? @relation("GatewayAddress", fields: [gatewayAddressId], references: [id], onDelete: Restrict)
  addresses      IpAddress[] @relation("SubnetAddresses")
  dhcpScope      DhcpScope?
  dhcpRelays     DhcpRelay[]
  dnsZone        DnsZone?
  layer3Interfaces Layer3Interface[]

  @@unique([networkId, cidr])
  @@unique([networkId, name])
  @@index([vlanId])
  @@map("ip_subnets")
}

model IpAddress {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  subnetId       String        @map("subnet_id") @db.Uuid
  address        String
  role           IpAddressRole
  interfaceId    String?       @unique @map("interface_id") @db.Uuid
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subnet       IpSubnet          @relation("SubnetAddresses", fields: [subnetId], references: [id], onDelete: Restrict)
  gatewayFor   IpSubnet?         @relation("GatewayAddress")
  interface    NetworkInterface? @relation(fields: [interfaceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, address])
  @@index([subnetId, role])
  @@map("ip_addresses")
}

enum DhcpServerStatus {
  PLANNED
  ACTIVE
  DISABLED
}

enum DhcpLeaseState {
  ACTIVE
  EXPIRED
  RELEASED
}

enum DhcpLeaseOrigin {
  SIMULATION
}

model DhcpServer {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  siteId         String           @map("site_id") @db.Uuid
  deviceId       String?          @map("device_id") @db.Uuid
  name           String
  description    String?
  address        String?
  status         DhcpServerStatus @default(PLANNED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  scopes       DhcpScope[]
  relays       DhcpRelay[]

  @@unique([siteId, name])
  @@index([organizationId])
  @@index([deviceId])
  @@map("dhcp_servers")
}

model DhcpScope {
  id           String   @id @default(uuid()) @db.Uuid
  subnetId     String   @unique @map("subnet_id") @db.Uuid
  serverId     String   @map("server_id") @db.Uuid
  gateway      String
  dnsServers   String[] @default([]) @map("dns_servers")
  domain       String?
  leaseSeconds Int      @map("lease_seconds")
  enabled      Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subnet       IpSubnet          @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  server       DhcpServer        @relation(fields: [serverId], references: [id], onDelete: Restrict)
  pools        DhcpPool[]
  exclusions   DhcpExclusion[]
  reservations DhcpReservation[]
  leases       DhcpLease[]

  @@index([serverId])
  @@map("dhcp_scopes")
}

model DhcpPool {
  id           String   @id @default(uuid()) @db.Uuid
  scopeId      String   @map("scope_id") @db.Uuid
  startAddress String   @map("start_address")
  endAddress   String   @map("end_address")
  createdAt    DateTime @default(now()) @map("created_at")

  scope DhcpScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([scopeId])
  @@map("dhcp_pools")
}

model DhcpExclusion {
  id           String   @id @default(uuid()) @db.Uuid
  scopeId      String   @map("scope_id") @db.Uuid
  startAddress String   @map("start_address")
  endAddress   String   @map("end_address")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  scope DhcpScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([scopeId])
  @@map("dhcp_exclusions")
}

model DhcpReservation {
  id          String   @id @default(uuid()) @db.Uuid
  scopeId     String   @map("scope_id") @db.Uuid
  address     String
  macAddress  String   @map("mac_address")
  hostname    String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  scope DhcpScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, address])
  @@unique([scopeId, macAddress])
  @@index([scopeId])
  @@map("dhcp_reservations")
}

model DhcpLease {
  id         String          @id @default(uuid()) @db.Uuid
  scopeId    String          @map("scope_id") @db.Uuid
  address    String
  macAddress String          @map("mac_address")
  hostname   String?
  state      DhcpLeaseState  @default(ACTIVE)
  origin     DhcpLeaseOrigin @default(SIMULATION)
  startsAt   DateTime        @map("starts_at")
  expiresAt  DateTime        @map("expires_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  scope DhcpScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([scopeId, address])
  @@index([scopeId, state])
  @@index([macAddress])
  @@map("dhcp_leases")
}

model DhcpRelay {
  id            String   @id @default(uuid()) @db.Uuid
  subnetId      String   @map("subnet_id") @db.Uuid
  serverId      String   @map("server_id") @db.Uuid
  interfaceId   String?  @map("interface_id") @db.Uuid
  helperAddress String   @map("helper_address")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  subnet    IpSubnet          @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  server    DhcpServer        @relation(fields: [serverId], references: [id], onDelete: Restrict)
  interface NetworkInterface? @relation(fields: [interfaceId], references: [id], onDelete: Restrict)

  @@unique([subnetId, serverId])
  @@index([serverId])
  @@index([interfaceId])
  @@map("dhcp_relays")
}

enum DnsServerStatus {
  PLANNED
  ACTIVE
  DISABLED
}

enum DnsZoneKind {
  FORWARD
  REVERSE
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  NS
  PTR
  TXT
  SRV
}

model DnsServer {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  siteId         String          @map("site_id") @db.Uuid
  deviceId       String?         @map("device_id") @db.Uuid
  name           String
  description    String?
  address        String?
  status         DnsServerStatus @default(PLANNED)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  zones        DnsZone[]

  @@unique([siteId, name])
  @@index([organizationId])
  @@index([deviceId])
  @@map("dns_servers")
}

model DnsZone {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  serverId       String      @map("server_id") @db.Uuid
  subnetId       String?     @unique @map("subnet_id") @db.Uuid
  kind           DnsZoneKind
  name           String
  ttl            Int         @default(3600)
  enabled        Boolean     @default(true)
  description    String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  server       DnsServer    @relation(fields: [serverId], references: [id], onDelete: Restrict)
  subnet       IpSubnet?    @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  records      DnsRecord[]
  changes      DnsChange[]

  @@unique([organizationId, name])
  @@index([serverId])
  @@map("dns_zones")
}

model DnsRecord {
  id        String        @id @default(uuid()) @db.Uuid
  zoneId    String        @map("zone_id") @db.Uuid
  name      String
  type      DnsRecordType
  ttl       Int?
  rdata     String
  priority  Int?
  weight    Int?
  port      Int?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  zone DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, name, type, rdata])
  @@index([zoneId, name])
  @@map("dns_records")
}

model DnsChange {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  zone  DnsZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  actor User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([zoneId, createdAt])
  @@map("dns_changes")
}

enum Layer3Kind {
  PHYSICAL
  SVI
  SUBINTERFACE
}

enum Layer3Status {
  PLANNED
  ACTIVE
  DISABLED
}

enum RouteProtocol {
  CONNECTED
  STATIC
  DEFAULT
  OSPF
}

enum RouteStatus {
  ACTIVE
  PLANNED
  DISABLED
}

model Layer3Interface {
  id                String        @id @default(uuid()) @db.Uuid
  deviceId          String        @map("device_id") @db.Uuid
  name              String
  kind              Layer3Kind
  vlanId            String?       @map("vlan_id") @db.Uuid
  parentInterfaceId String?       @map("parent_interface_id") @db.Uuid
  address           String
  subnetId          String        @map("subnet_id") @db.Uuid
  status            Layer3Status  @default(PLANNED)
  description       String?
  ospfAreaId        String?       @map("ospf_area_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  device          Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  vlan            Vlan?             @relation(fields: [vlanId], references: [id], onDelete: Restrict)
  parentInterface NetworkInterface? @relation(fields: [parentInterfaceId], references: [id], onDelete: Restrict)
  subnet          IpSubnet          @relation(fields: [subnetId], references: [id], onDelete: Restrict)
  ospfArea        OspfArea?         @relation(fields: [ospfAreaId], references: [id], onDelete: SetNull)
  routes          Route[]

  @@unique([deviceId, name])
  @@index([vlanId])
  @@index([subnetId])
