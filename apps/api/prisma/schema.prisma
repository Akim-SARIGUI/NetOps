  fabricId            String          @map("fabric_id") @db.Uuid
  actorId             String          @map("actor_id") @db.Uuid
  sourcePromotionId   String?         @unique @map("source_promotion_id") @db.Uuid
  sourceEnvironment   Environment     @map("source_environment")
  targetEnvironment   Environment     @map("target_environment")
  targetSiteId        String          @map("target_site_id") @db.Uuid
  phase               PromotionPhase  @default(PREPARED)
  configuration       String
  applied             Boolean         @default(false)
  pushed              Boolean         @default(false)
  confirmProduction   Boolean         @default(false) @map("confirm_production")
  validatedAt         DateTime?       @map("validated_at")
  promotedAt          DateTime?       @map("promoted_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fabric          LabFabric     @relation(fields: [fabricId], references: [id], onDelete: Restrict)
  actor           User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetSite      Site          @relation(fields: [targetSiteId], references: [id], onDelete: Restrict)
  sourcePromotion LabPromotion? @relation("PromotionChain", fields: [sourcePromotionId], references: [id], onDelete: Restrict)
  followUp        LabPromotion? @relation("PromotionChain")

  @@index([organizationId, createdAt])
  @@index([fabricId])
  @@index([targetSiteId])
  @@map("lab_promotions")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}
